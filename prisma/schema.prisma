generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  LOCKED
  WITHDRAWN
}

enum UserRole {
  USER
  ADMIN
}

enum VolunteerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum VolunteerMemberStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum VolunteerEventStatus {
  DRAFT
  OPEN
  CLOSED
  COMPLETED
  CANCELED
}

enum VolunteerEventVisibility {
  PUBLIC
  PRIVATE
}

enum VolunteerParticipationStatus {
  APPLIED
  ATTENDED
  ABSENT
  CANCELED
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  username        String          @unique @db.VarChar(64)
  passwordHash    String          @db.VarChar(255)
  status          UserStatus      @default(ACTIVE)
  role            UserRole        @default(USER)
  failedLoginCount Int             @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  refreshSessions RefreshSession[]

  @@index([status])
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @db.VarChar(128)
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model VolunteerApplication {
  id                  String                     @id @default(uuid()) @db.Uuid
  userId              String                     @db.Uuid
  name                String                     @db.VarChar(50)
  phone               String                     @db.VarChar(20)
  birthDate           DateTime                   @db.Date
  gender              String                     @db.VarChar(20)
  neighborhood        String                     @db.VarChar(100)
  preferredActivities Json
  motivation          String                     @db.VarChar(2000)
  photoFileId         String?                    @db.Uuid
  status              VolunteerApplicationStatus @default(PENDING)
  rejectionReason     String?
  adminMemo           String?
  reviewedBy         String?                    @db.Uuid
  reviewedAt         DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  member              VolunteerMember?

  @@index([userId, status])
  @@index([status, createdAt])
}

model VolunteerMember {
  id            String                 @id @default(uuid()) @db.Uuid
  userId        String                 @unique @db.Uuid
  applicationId String                 @unique @db.Uuid
  status        VolunteerMemberStatus  @default(ACTIVE)
  joinedAt      DateTime               @default(now())
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  application   VolunteerApplication   @relation(fields: [applicationId], references: [id])
  participations VolunteerParticipation[]

  @@index([status, joinedAt])
}

model VolunteerFile {
  id          String   @id @default(uuid()) @db.Uuid
  objectKey   String   @unique
  contentType String
  byteSize    Int
  width       Int?
  height      Int?
  isPrivate   Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  events      VolunteerEvent[]
}

model VolunteerEvent {
  id                    String                    @id @default(uuid()) @db.Uuid
  title                 String
  type                  String
  imageFileId           String                    @db.Uuid
  startAt               DateTime
  endAt                 DateTime
  recruitmentDeadlineAt DateTime
  location              String
  capacity              Int
  description           String
  supplies              String?
  precautions           String?
  status                VolunteerEventStatus     @default(DRAFT)
  visibility            VolunteerEventVisibility @default(PUBLIC)
  closeReason           String?
  cancelReason          String?
  createdBy             String                    @db.Uuid
  updatedBy             String                    @db.Uuid
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  imageFile             VolunteerFile              @relation(fields: [imageFileId], references: [id])
  participations        VolunteerParticipation[]

  @@index([status, startAt])
  @@index([visibility, recruitmentDeadlineAt])
}

model VolunteerParticipation {
  id                   String                      @id @default(uuid()) @db.Uuid
  eventId              String                      @db.Uuid
  memberId             String                      @db.Uuid
  status               VolunteerParticipationStatus @default(APPLIED)
  appliedAt            DateTime                    @default(now())
  canceledAt           DateTime?
  attendanceCheckedAt  DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  event                VolunteerEvent              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member               VolunteerMember             @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@index([memberId, status])
  @@index([eventId, status])
}

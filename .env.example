# 동일 Next.js origin. 외부 백엔드 URL을 넣지 않습니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 독립 플랫폼 서버 비밀값은 실제 환경에서 주입합니다.
DATABASE_URL=postgresql://user:password@localhost:5432/volunteer
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FILE_STORAGE_MODE=local

# 실제 API가 기본이며, 로컬에서 백엔드 없이 화면을 확인할 때만 true로 설정합니다.
NEXT_PUBLIC_USE_VOLUNTEER_MOCKS=false

# ACTIVE_MEMBER | NEW_APPLICANT | PENDING_APPLICATION | REJECTED_APPLICATION | SUSPENDED_MEMBER
NEXT_PUBLIC_VOLUNTEER_MOCK_SCENARIO=ACTIVE_MEMBER

# CI에서 Spring Boot OpenAPI 문서를 비교할 때만 설정합니다.
OPENAPI_URL=

# 실제 Spring Boot 인증 E2E는 기본적으로 비활성화됩니다. 비밀값은 로컬 .env에만 설정하세요.
E2E_RUN_REAL_BACKEND=false
E2E_BACKEND_API_BASE_URL=http://localhost:3000
E2E_ADMIN_API_BASE_URL=http://localhost:3000
E2E_USER_ACCESS_TOKEN=
# 기본값은 DSHelper(BE) test API(`/test/temp-token`)에서 임시 관리자 토큰을 발급받습니다.
E2E_FETCH_ADMIN_TOKEN=true
E2E_ADMIN_TOKEN_URL=
# 수동 토큰 주입이 꼭 필요한 경우에만 사용합니다.
E2E_ADMIN_ACCESS_TOKEN=
# mutation 검증을 실행할 때만 true로 설정하고, 한 번에 하나의 작업만 선택합니다.
E2E_ADMIN_MUTATE=false
E2E_ADMIN_MUTATION=approve
E2E_AUTO_SELECT_TARGET=false
E2E_APPLICATION_ID=
E2E_REJECTION_REASON=E2E 계약 검증용 반려
E2E_EVENT_ID=
E2E_ATTENDED_PARTICIPATION_IDS=
E2E_ABSENT_PARTICIPATION_IDS=
